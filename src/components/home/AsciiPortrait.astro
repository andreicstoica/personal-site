---
interface Props {
	imagePath?: string;
	outputId?: string;
	label?: string;
	gridSize?: number;
}

const {
	imagePath = "/images/about.webp",
	outputId = "hero-ascii-portrait",
	label = "Portrait of Andrei Stoica",
	gridSize = 34,
} = Astro.props;
---

<div
	class="ascii-portrait hero-sigil"
	style={`--ascii-portrait-grid: ${gridSize}`}
	aria-label={label}
	role="img"
>
	<div id={outputId} class="ascii-portrait-output font-mono">···</div>
</div>

<script define:vars={{ imagePath, outputId, gridSize }}>
	import { AsciiImageConverter } from "../../lib/asciiVideo";

	const output = document.getElementById(outputId);
	let portraitConverter = null;

	function initPortrait() {
		if (!output) {
			return;
		}

		portraitConverter = new AsciiImageConverter(imagePath, output, {
			invertColors: false,
			animate: false,
			maxWidth: gridSize,
			maxHeight: gridSize,
			squareCrop: true,
			brightnessThreshold: 0.08,
		});
		portraitConverter.start();
	}

	if (document.readyState === "loading") {
		document.addEventListener("DOMContentLoaded", initPortrait);
	} else {
		initPortrait();
	}

	window.addEventListener("beforeunload", () => {
		portraitConverter?.destroy();
	});
</script>
