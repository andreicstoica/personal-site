---
import { personalStatement } from "../../lib/experience";
---

<section class="hero-section">
  <div class="hero-copy z-20 relative">
    <p class="text-hero" set:html={personalStatement.primary} />
    <p class="text-hero-muted" set:html={personalStatement.secondary} />
  </div>

  <div class="hero-ascii pointer-events-none z-10">
    <div id="ascii-output" class="ascii-display">Loading ASCII...</div>
  </div>
</section>

<style>
  .hero-section {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.25rem;
    padding-block: 0.75rem 1rem;
    align-items: start;
  }

  .hero-ascii {
    width: 100%;
  }

  .ascii-display {
    font-family: var(--font-mono);
    font-size: clamp(0.2rem, 0.38vw, 0.32rem);
    width: 100%;
    height: 14rem;
    display: flex;
    align-items: center;
    justify-content: center;
    background: transparent;
    white-space: pre;
    line-height: 0.7;
    text-align: left;
    letter-spacing: 0.06em;
    animation: ascii-glow 3s ease-in-out infinite alternate;
    overflow: hidden;
    margin: 0;
    padding: 0;
    opacity: 0.75;
    filter: drop-shadow(0 1px 1px rgb(0 0 0 / 0.04));
  }

  #ascii-output {
    color: var(--color-ascii-bright, #5a6aff);
    text-shadow:
      0 0 4px currentColor,
      0 0 8px currentColor,
      0 0 12px rgba(90, 106, 255, 0.35);
  }

  @keyframes ascii-glow {
    0% {
      filter: brightness(1) contrast(1);
    }
    100% {
      filter: brightness(1.15) contrast(1.08);
    }
  }

  @media (min-width: 768px) {
    .hero-section {
      grid-template-columns: minmax(0, 1.4fr) minmax(0, 1fr);
      gap: clamp(0.75rem, 2.5vw, 1.5rem);
      padding-block: 0.5rem 0.75rem;
    }

    .ascii-display {
      height: 17.5rem;
      opacity: 0.82;
    }
  }

  @media (min-width: 1024px) {
    .ascii-display {
      height: 20rem;
      font-size: clamp(0.22rem, 0.4vw, 0.36rem);
      opacity: 0.9;
    }
  }

  @media (max-width: 767px) {
    .ascii-display {
      height: 11rem;
      font-size: 0.28rem;
      letter-spacing: 0.04em;
      line-height: 0.75;
      opacity: 0.35;
    }
  }

  @media (prefers-color-scheme: dark) {
    .ascii-display {
      color: var(--color-ascii-bright);
      text-shadow:
        0 0 6px currentColor,
        0 0 12px currentColor,
        0 0 18px rgba(90, 106, 255, 0.35);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .ascii-display {
      animation: none;
    }
  }
</style>

<script>
  import { AsciiImageConverter, AsciiVideoConverter } from "../../lib/asciiVideo";

  const output = document.getElementById("ascii-output") as HTMLDivElement;
  let converter: AsciiImageConverter | AsciiVideoConverter | null = null;

  async function initAsciiImage() {
    try {
      converter = new AsciiImageConverter("/images/maple.webp", output, false);
      await converter.start();
    } catch (error) {
      console.error("Failed to initialize ASCII image:", error);
      output.innerHTML = "ASCII Image Error - Check Console";
    }
  }

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", initAsciiImage);
  } else {
    initAsciiImage();
  }

  window.addEventListener("beforeunload", () => {
    if (converter) {
      converter.destroy();
    }
  });

  document.addEventListener("visibilitychange", () => {
    if (converter) {
      if (document.hidden) {
        converter.stop();
      } else {
        converter.start();
      }
    }
  });
</script>
