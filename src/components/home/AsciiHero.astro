---
import { personalStatement } from "../../lib/experience";
import AsciiCanvas from "./AsciiCanvas.svelte";
---

<section
  class="relative w-full min-h-[65vh] lg:min-h-[70vh] overflow-hidden flex flex-col md:flex-row justify-between pt-8 lg:pt-10"
  style="background-color: var(--color-bg-primary);"
>
  <div class="z-20 md:max-w-2xl flex-shrink-0 relative md:pr-8">
    <p
      class="text-lead max-w-2xl"
      set:html={personalStatement}
    />
  </div>

  <div
    class="w-full md:w-auto md:flex-shrink-0 pointer-events-none z-10 mt-8 md:mt-0"
  >
    <AsciiCanvas client:visible src="/images/maple.webp" mode="image" />
  </div>
</section>

<style>
  :global(.ascii-display) {
    font-size: clamp(0.2rem, 0.4vw, 0.35rem);
    width: 100%;
    height: 500px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: transparent;
    white-space: pre;
    line-height: 0.7;
    text-align: left;
    animation: ascii-glow 3s ease-in-out infinite alternate;
    overflow: hidden;
    font-family: monospace;
    letter-spacing: 0.08em;
  }

  :global(#ascii-output),
  :global(.ascii-display) {
    color: var(--color-ascii-bright, #5a6aff);
    text-shadow:
      0 0 4px currentColor,
      0 0 8px currentColor,
      0 0 12px rgba(90, 106, 255, 0.4);
  }

  @keyframes ascii-glow {
    0% {
      filter: brightness(1) contrast(1);
    }
    100% {
      filter: brightness(1.2) contrast(1.1);
    }
  }

  @media (min-width: 1024px) {
    :global(.ascii-display) {
      width: 100%;
      height: 650px;
      font-size: clamp(0.25rem, 0.45vw, 0.4rem);
    }

    section {
      align-items: flex-start;
      padding-top: 2rem;
      padding-bottom: 2rem;
    }
  }

  @media (max-width: 768px) {
    section {
      flex-direction: column;
      align-items: flex-start;
      gap: 2.5rem;
    }

    :global(.ascii-display) {
      font-size: 0.3rem;
      letter-spacing: 0.05em;
      width: 100%;
      height: 350px;
      line-height: 0.8;
      opacity: 0.3;
    }
  }

  @media (prefers-color-scheme: dark) {
    :global(.ascii-display) {
      color: var(--color-ascii-bright);
      text-shadow:
        0 0 6px currentColor,
        0 0 12px currentColor,
        0 0 18px rgba(90, 106, 255, 0.4);
    }
  }
</style>
