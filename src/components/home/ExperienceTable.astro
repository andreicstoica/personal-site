---
import { experiences } from "../../lib/experience";
import { experienceFilterCss } from "../../lib/experienceUi";
import { EXPERIENCE_TYPES, type Experience } from "../../lib/types";
import ExperienceRow from "./ExperienceRow.astro";

const allTypes = EXPERIENCE_TYPES.filter((type) =>
	experiences.some((exp) => exp.type === type),
);
const filterCss = experienceFilterCss();
---

<section id="experience-table" class="w-full" data-filter="">
  <div class="experience-grid type-label hidden lg:grid gap-x-4 xl:gap-x-6 items-end pb-2 font-normal text-xs uppercase tracking-wider text-[var(--color-text-secondary)] sticky top-0 bg-[var(--color-bg-primary)] z-10">
    <div class="col-span-1">Experience</div>
    <div class="col-span-2">Role</div>
    <div class="col-span-2">
      <select id="typeFilter" class="experience-filter w-full border max-w-30 border-[var(--color-bg-secondary)] px-2 bg-transparent uppercase">
        <option value="">all</option>
        {allTypes.map(type => (
          <option value={type}>{type}</option>
        ))}
      </select>
    </div>
    <div class="col-span-1 text-end mr-2">Date</div>
    <div class="col-span-4">Media</div>
  </div>

  <div id="experience-rows" class="experience-rows">
    <div id="experience-rows-inner" class="space-y-4">
      {experiences.map((experience: Experience) => (
        <ExperienceRow experience={experience} />
      ))}
    </div>
  </div>
</section>

<Fragment set:html={`<style>${filterCss}</style>`} />

<script>
  import { isExperienceType } from "../../lib/types";

  function mountExperienceTable(): () => void {
    const experienceTable = document.getElementById("experience-table");
    const experienceRows = document.getElementById("experience-rows");
    const experienceRowsInner = document.getElementById("experience-rows-inner");
    const filterSelect = document.getElementById("typeFilter");

    if (
      !experienceTable ||
      !experienceRows ||
      !experienceRowsInner ||
      !(filterSelect instanceof HTMLSelectElement)
    ) {
      return () => {};
    }

    let reservedHeight = 0;

    const getFilterValue = () => experienceTable.dataset.filter ?? "";

    const reserveFromAllView = () => {
      if (getFilterValue()) {
        return;
      }

      const measured = experienceRowsInner.getBoundingClientRect().height;
      if (measured <= reservedHeight) {
        return;
      }

      reservedHeight = measured;
      experienceRows.style.minHeight = `${reservedHeight}px`;
    };

    const onFilter = () => {
      const next = filterSelect.value;
      experienceTable.dataset.filter =
        next === "" || isExperienceType(next) ? next : "";

      if (!filterSelect.value) {
        requestAnimationFrame(reserveFromAllView);
      }
    };

    const onResize = () => {
      if (getFilterValue()) {
        return;
      }

      reservedHeight = 0;
      experienceRows.style.minHeight = "";
      requestAnimationFrame(reserveFromAllView);
    };

    filterSelect.addEventListener("change", onFilter);
    window.addEventListener("resize", onResize);
    const resizeObserver = new ResizeObserver(() => {
      reserveFromAllView();
    });
    resizeObserver.observe(experienceRowsInner);
    requestAnimationFrame(reserveFromAllView);

    return () => {
      filterSelect.removeEventListener("change", onFilter);
      window.removeEventListener("resize", onResize);
      resizeObserver.disconnect();
    };
  }

  let release = mountExperienceTable();
  document.addEventListener("astro:page-load", () => {
    release();
    release = mountExperienceTable();
  });
</script>
