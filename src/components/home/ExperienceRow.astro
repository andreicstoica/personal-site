---
import {
	displayFontStyle,
	experienceNameStyle,
	formatDateRange,
	usesDisplayFont,
} from "../../lib/experienceUi";
import type { Experience } from "../../lib/types";
import MediaGallery from "../gallery/MediaGallery.astro";
import ProjectEnhancedDescription from "../projects/ProjectEnhancedDescription.astro";

interface Props {
	experience: Experience;
}

const { experience } = Astro.props;
// Chip cells run leading-none so cloned wrap fragments advance by 16px instead
// of the inherited 1.55 line box — that's what closes the gap between lines.
// It raises the first baseline by half the drop (4.4px), so the optical offsets
// shift down by the same amount to keep the chip where it was tuned.
const nameOffset = usesDisplayFont(experience.name) ? "mt-0" : "mt-0.75";
---

<div
  class="experience-row border-t"
  data-type={experience.type}
>
  <div class="hidden lg:grid lg:grid-cols-10 gap-2 items-start">
    <div class={`col-span-1 leading-none ${nameOffset}`}>
      <span
        class="line-clamp-2"
        style={experienceNameStyle(experience.name, experience.type)}
      >
        {experience.name}
      </span>
    </div>

    <div class="col-span-5">
      <div class="grid grid-cols-5 gap-3 mb-4 text-pretty">
        <div class="col-span-2">
          <div class="text-[.92rem]" style={displayFontStyle(experience.name)}>
            {experience.role}
          </div>
        </div>

        <div class={`col-span-2 leading-none ${nameOffset}`}>
          <span
            class="font-serif text-sm leading-none bg-(--color-bg-secondary) p-0.75 box-decoration-clone [-webkit-box-decoration-break:clone]"
            style={displayFontStyle(experience.name)}
          >
            {experience.tags.join(", ")}
          </span>
        </div>

        <div class="col-span-1">
          <div class="font-mono text-[.92rem] text-end mr-2">
            {formatDateRange(experience.startDate, experience.endDate)}
          </div>
        </div>
      </div>

      {
        experience.description && (
          <ProjectEnhancedDescription description={experience.description} />
        )
      }
    </div>

    <MediaGallery
      images={experience.images}
      experienceName={experience.name}
      variant="desktop"
    />
  </div>

  <div class="lg:hidden">
    <div class="flex justify-between gap-4 mb-3">
      <span
        class="line-clamp-2"
        style={experienceNameStyle(experience.name, experience.type)}
      >
        {experience.name}
      </span>

      <div
        class="text-sm flex-none mt-1"
        style={displayFontStyle(experience.name)}
      >
        {experience.role}
      </div>

      <div class="font-mono text-sm flex-shrink-0 mt-1">
        {formatDateRange(experience.startDate, experience.endDate)}
      </div>
    </div>

    {
      experience.description && (
        <div class="text-sm leading-relaxed mb-3">
          <ProjectEnhancedDescription description={experience.description} />
        </div>
      )
    }

    <MediaGallery
      images={experience.images}
      experienceName={experience.name}
      variant="mobile"
    />
  </div>
</div>

<style>
  /* Table rules are the footer's hairline, not a palette gray — holds in both modes from one rule. */
  .experience-row {
    border-top-color: color-mix(
      in srgb,
      var(--color-text-primary) 12%,
      transparent
    );
  }
</style>
