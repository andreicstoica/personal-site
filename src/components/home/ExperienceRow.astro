---
import {
	displayRowStyle,
	experienceNameStyle,
	formatDateRange,
	nameBreakParts,
	usesDisplayFont,
} from "../../lib/experienceUi";
import type { Experience } from "../../lib/types";
import MediaGallery from "../gallery/MediaGallery.astro";
import ProjectEnhancedDescription from "../projects/ProjectEnhancedDescription.astro";

interface Props {
	experience: Experience;
}

const { experience } = Astro.props;
// Name and tags chips are inline boxes inside an overflow-hidden wrapper, so
// every face's painted top clips flush right under the row's separator — no
// per-face margin tuning. The name wrapper adds line-clamp-2 (never on the
// chip itself: -webkit-box would override display:inline and slab the
// background across the column). The chips run line-height 1.6 so each
// wrapped line paints its own separated bar. leading-none keeps the cells'
// struts short. Description text uses the secondary tone.
// Exception: the Lumber Sans row renders all-caps at 0.8rem (displayRowStyle)
// — at the shared sizes its cap-height presence dwarfs
// the mixed-case Plex rows.
---

<div
  class="experience-row border-t"
  data-type={experience.type}
  data-display-font={usesDisplayFont(experience.name) ? "" : undefined}
>
  <div class="experience-grid hidden lg:grid gap-x-4 xl:gap-x-6 items-start">
    <div class="col-span-1 leading-none">
      <span class="line-clamp-2">
        <span
          class="row-chip break-words"
          style={experienceNameStyle(experience.name, experience.type)}
        >
          {nameBreakParts(experience.name).map((part, i) => (
            <>{i > 0 && <wbr />}{part}</>
          ))}
        </span>
      </span>
    </div>

    <div class="col-span-5">
      <div class="grid grid-cols-5 gap-x-4 xl:gap-x-6 mb-4 text-pretty">
        <div class="col-span-2">
          <div class="text-sm" style={displayRowStyle(experience.name)}>
            {experience.role}
          </div>
        </div>

        <div class="col-span-2 leading-none">
          <span class="block overflow-hidden">
            <span
              class="row-chip type-label text-sm leading-[1.6] bg-(--color-bg-secondary) p-0.75 box-decoration-clone [-webkit-box-decoration-break:clone]"
              style={displayRowStyle(experience.name)}
            >
              {experience.tags.join(", ")}
            </span>
          </span>
        </div>

        <div class="col-span-1">
          <div class="type-label text-sm tabular-nums tracking-[-0.02em] text-end mr-2">
            {formatDateRange(experience.startDate, experience.endDate)}
          </div>
        </div>
      </div>

      {
        experience.description && (
          <ProjectEnhancedDescription description={experience.description} />
        )
      }
    </div>

    <MediaGallery
      images={experience.images}
      experienceName={experience.name}
      variant="desktop"
    />
  </div>

  <div class="lg:hidden">
    <div class="flex justify-between gap-4 mb-2">
      <span class="line-clamp-2 leading-none min-w-min">
        <span
          class="row-chip break-words"
          style={experienceNameStyle(experience.name, experience.type)}
        >
          {nameBreakParts(experience.name).map((part, i) => (
            <>{i > 0 && <wbr />}{part}</>
          ))}
        </span>
      </span>

      <div
        class="text-sm flex-1 min-w-0 mt-px"
        style={displayRowStyle(experience.name)}
      >
        {experience.role}
      </div>

      <div class="text-sm tabular-nums flex-shrink-0 mt-px">
        {formatDateRange(experience.startDate, experience.endDate)}
      </div>
    </div>

    {
      experience.description && (
        <div class="text-sm leading-relaxed mb-3">
          <ProjectEnhancedDescription description={experience.description} />
        </div>
      )
    }

    <MediaGallery
      images={experience.images}
      experienceName={experience.name}
      variant="mobile"
    />
  </div>
</div>

<style>
  /* Table rules use the shared divider gray — holds in both modes from one
     token. */
  .experience-row {
    border-top-color: var(--color-bg-secondary);
  }

  /* LumberSans ships taller ascent metrics than Plex, so its chips paint
     2px below the rule instead of clipping flush under it like every other
     row. Lift them to match. */
  .experience-row[data-display-font] .row-chip {
    position: relative;
    top: -2px;
  }
</style>
