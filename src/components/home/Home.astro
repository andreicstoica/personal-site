---
import { personalStatement } from "../../lib/experience";
import ExperienceTable from "./ExperienceTable.astro";

// experience.ts holds the copy as one string; split it into its two paragraphs.
const [intro = "", focus = ""] = personalStatement.split("<br><br>");

// The closing CTA is rewritten here because experience.ts is never staged.
// If that sentence ever changes upstream, replace() no-ops and the original
// copy renders — no breakage, just the old wording.
const introCta = intro.replace(
	"There's a short <a href='/about'>about</a>, mostly outside of work.",
	"Learn more <a class='lead-link' href='/about'>about</a> me outside of work, and my <a class='lead-link' href='/canon'>canon</a> of people and ideas that inspire me.",
);

// The second paragraph leads with the shorter AI line.
const focusLead = focus
	.replace(
		"Lately I've been exploring reflective AI tools with a focus on simple interfaces that feel intuitive and well considered, and have been writing",
		"Lately I’ve been exploring simpler and more intuitive AI interface design, and have been writing",
	)
	.replace(
		"<a target='_blank' href='https://blog.andrei.bio/'>blog</a>",
		"<a class='lead-link' target='_blank' rel='noopener' href='https://blog.andrei.bio/'>blog</a>",
	);
---

<div class="flex flex-col gap-10 lg:gap-16">
  <div class="lg:pt-4 experience-inset mx-auto flex w-full max-w-[46rem] flex-col gap-5">
    <p class="text-lead" set:html={introCta} />
    <p class="text-lead" set:html={focusLead} />
  </div>
  <ExperienceTable />
</div>
