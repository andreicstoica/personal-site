---
import {
	type PixelarticonName,
	pixelarticons,
} from "../../icons/pixelarticons";

interface Props {
	name: PixelarticonName;
	class?: string;
	id?: string;
}

const { name, class: className = "w-6 h-6", id } = Astro.props;
const markup = pixelarticons[name];
---

<svg
	id={id}
	class={className}
	fill="currentColor"
	xmlns="http://www.w3.org/2000/svg"
	viewBox="0 0 24 24"
	aria-hidden="true"
	set:html={markup}
/>
