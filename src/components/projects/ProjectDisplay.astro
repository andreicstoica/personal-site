---
import type { Project } from "../../lib/types";
import MediaGallery from "../gallery/MediaGallery.astro";
import ProjectDetails from "./ProjectDetails.astro";
import ProjectLinks from "./ProjectLinks.astro";
import ProjectSection from "./ProjectSection.astro";
import ProjectVideo from "./ProjectVideo.astro";

interface Props {
	project: Project;
}

const { project } = Astro.props;
---

<div class="w-full py-4 lg:mt-3.5 max-w-4xl mx-auto px-4 lg:px-8">
  <div class="mb-8">
    <h1 class="text-xl lg:text-xl font-bold text-[--color-text-primary] mb-1">
      {project.title}
    </h1>
    <p class="text-md text-[--color-text-secondary] leading-relaxed">
      {project.description}
    </p>
  </div>

  <ProjectSection title="Technologies">
    <div class="flex flex-wrap gap-3">
      {
        project.technologies.map((tech) => (
          <span class="px-4 py-2 bg-blue-100 dark:bg-blue-900 text-blue-800 dark:text-blue-200 text-sm font-medium">
            {tech}
          </span>
        ))
      }
    </div>
  </ProjectSection>

  <ProjectLinks project={project} />
  <ProjectVideo project={project} />

  {
    project.images && project.images.length > 0 && (
      <ProjectSection title="Screenshots">
        <MediaGallery
          images={project.images}
          experienceName={project.title}
          variant="desktop"
        />
      </ProjectSection>
    )
  }

  {project.technicalDetails && <ProjectDetails details={project.technicalDetails} />}
</div>
