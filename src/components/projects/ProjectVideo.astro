---
import type { Project } from "../../lib/types";
import ProjectSection from "./ProjectSection.astro";

interface Props {
	project: Project;
}

const { project } = Astro.props;
const video = project.video;
const isYoutube = Boolean(video?.includes("youtube.com"));
const embedSrc = video?.includes("youtube.com/shorts/")
	? `${video.replace("youtube.com/shorts/", "youtube.com/embed/")}?autoplay=1`
	: video;
---

{
  video && (
    <ProjectSection title="Video Demo">
      {isYoutube ? (
        <div class="relative w-full" style="padding-bottom: 56.25%;">
          <iframe
            src={embedSrc}
            class="absolute top-0 left-0 w-full h-full rounded-lg"
            allow="autoplay; fullscreen; picture-in-picture"
            allowfullscreen
          />
        </div>
      ) : (
        <div class="w-full">
          <video
            src={video}
            class="w-full rounded-lg media-reveal"
            controls
            autoplay
            loop
            muted
            playsinline
            onloadeddata="this.classList.add('is-loaded')"
          />
        </div>
      )}
    </ProjectSection>
  )
}
