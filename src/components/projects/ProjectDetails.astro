---
import type { Project } from "../../lib/types";
import ProjectSection from "./ProjectSection.astro";

interface Props {
	details: NonNullable<Project["technicalDetails"]>;
}

const { details } = Astro.props;

const groups = [
	{ title: "Key Features", items: details.keyFeatures },
	{ title: "Technical Challenges", items: details.challenges },
	{ title: "Implementation", items: details.implementation },
];
---

<ProjectSection title="Technical Overview">
  {
    groups.map((group) => (
      <div class="mb-6">
        <h3 class="text-md font-semibold text-[--color-text-primary] mb-2">
          {group.title}
        </h3>
        <ul class="list-disc list-inside space-y-1">
          {group.items.map((item) => (
            <li class="text-md text-[--color-text-secondary]">{item}</li>
          ))}
        </ul>
      </div>
    ))
  }
</ProjectSection>
