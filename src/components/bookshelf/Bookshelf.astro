---
import { bookshelf } from '../../lib/bookshelf';
import BookshelfPoster from './BookshelfPoster.astro';

interface Props {
	heading?: string;
	lead?: string;
	class?: string;
}

const {
	heading = 'Bookshelf',
	lead,
	class: className,
} = Astro.props;
---

{
	bookshelf.length > 0 && (
		<section class:list={['bookshelf', className]}>
			<header class="bookshelf__header">
				<h2 class="bookshelf__heading">{heading}</h2>
				{lead && <p class="bookshelf__lead">{lead}</p>}
			</header>

			<div class="bookshelf__stage">
				<div class="bookshelf__inner">
					<ul class="bookshelf__row">
						{bookshelf.map((item) => (
							<li class="bookshelf__slot">
								<BookshelfPoster item={item} />
							</li>
						))}
					</ul>
					<div class="bookshelf__plank" aria-hidden="true">
						<span class="bookshelf__plank-fill" />
						<span class="bookshelf__plank-grain" />
						<span class="bookshelf__plank-lip" />
					</div>
				</div>
			</div>

			{/* Shared SVG filter for grain — one instance per page */}
			<svg class="bookshelf__filters" aria-hidden="true" focusable="false">
				<filter
					id="bookshelf-grain"
					x="0%"
					y="0%"
					width="100%"
					height="100%"
					color-interpolation-filters="sRGB"
				>
					<feTurbulence
						type="fractalNoise"
						baseFrequency="0.85"
						numOctaves="3"
						stitchTiles="stitch"
						result="noise"
					/>
					<feColorMatrix
						in="noise"
						type="matrix"
						values="0 0 0 0 0.15
                    0 0 0 0 0.15
                    0 0 0 0 0.15
                    0 0 0 0.55 0"
						result="mono"
					/>
					<feComposite in="mono" in2="SourceGraphic" operator="in" />
				</filter>
			</svg>
		</section>
	)
}

<style>
	.bookshelf {
		display: flex;
		flex-direction: column;
		gap: 1rem;
		width: 100%;
		padding-block: 0.25rem 0.75rem;
	}

	.bookshelf__header {
		display: flex;
		flex-direction: column;
		gap: 0.35rem;
		padding-inline: 0.15rem;
	}

	.bookshelf__heading {
		font-size: 1.25rem;
		font-weight: 500;
		margin: 0;
		color: var(--color-text-primary);
		text-transform: capitalize;
	}

	.bookshelf__lead {
		margin: 0;
		color: var(--color-text-secondary);
		line-height: var(--leading-normal);
		font-size: var(--text-sm);
		max-width: 36rem;
	}

	.bookshelf__stage {
		overflow-x: auto;
		overscroll-behavior-x: contain;
		scrollbar-width: thin;
		-webkit-overflow-scrolling: touch;
		padding-block: 0.35rem 0.5rem;
	}

	.bookshelf__inner {
		display: inline-flex;
		flex-direction: column;
		width: max-content;
		max-width: none;
		gap: 0.75rem;
		padding-inline: 0.75rem;
		padding-top: 0.5rem;
	}

	.bookshelf__row {
		list-style: none;
		margin: 0;
		padding: 0;
		display: flex;
		align-items: flex-end;
		gap: 0.85rem;
	}

	.bookshelf__slot {
		margin: 0;
		padding: 0;
		flex: 0 0 auto;
	}

	.bookshelf__plank {
		position: relative;
		width: 100%;
		height: 0.85rem;
		isolation: isolate;
		overflow: hidden;
		border-radius: 1px;
	}

	.bookshelf__plank-fill {
		position: absolute;
		inset: 0;
		background: linear-gradient(
			to bottom,
			color-mix(in srgb, var(--color-text-primary) 14%, var(--color-bg-primary)),
			color-mix(in srgb, var(--color-text-primary) 28%, var(--color-bg-primary)) 55%,
			color-mix(in srgb, var(--color-text-primary) 18%, var(--color-bg-primary))
		);
		box-shadow:
			0 1px 0 color-mix(in srgb, var(--color-text-primary) 22%, transparent),
			0 10px 18px -12px rgb(0 0 0 / 0.4);
	}

	.bookshelf__plank-grain {
		position: absolute;
		inset: 0;
		opacity: 0.45;
		mix-blend-mode: multiply;
		filter: url(#bookshelf-grain);
		background: color-mix(in srgb, var(--color-text-primary) 35%, transparent);
		pointer-events: none;
	}

	.bookshelf__plank-lip {
		position: absolute;
		left: 0;
		right: 0;
		top: 0;
		height: 2px;
		background: color-mix(in srgb, #fff 35%, var(--color-text-primary) 8%);
		opacity: 0.55;
		pointer-events: none;
	}

	.bookshelf__filters {
		position: absolute;
		width: 0;
		height: 0;
		overflow: hidden;
	}

	@media (prefers-color-scheme: dark) {
		.bookshelf__plank-fill {
			background: linear-gradient(
				to bottom,
				color-mix(in srgb, #fff 12%, var(--color-bg-primary)),
				color-mix(in srgb, #fff 22%, var(--color-bg-primary)) 55%,
				color-mix(in srgb, #fff 10%, var(--color-bg-primary))
			);
			box-shadow:
				0 1px 0 color-mix(in srgb, #fff 14%, transparent),
				0 10px 18px -12px rgb(0 0 0 / 0.7);
		}

		.bookshelf__plank-grain {
			mix-blend-mode: soft-light;
			opacity: 0.55;
			background: color-mix(in srgb, #fff 28%, transparent);
		}

		.bookshelf__plank-lip {
			background: color-mix(in srgb, #fff 22%, transparent);
			opacity: 0.4;
		}
	}

	@media (prefers-reduced-transparency: reduce) {
		.bookshelf__plank-grain {
			display: none;
		}
	}
</style>
