---
import {
	bookshelf,
	getBookshelfByKind,
	type BookshelfKind,
} from '../../lib/bookshelf';
import BookshelfPoster from './BookshelfPoster.astro';

interface Props {
	/** Filter to one kind, or show all */
	kind?: BookshelfKind | 'all';
	/** Compact posters for tight layouts */
	size?: 'default' | 'compact';
	/** Section heading override */
	heading?: string;
	/** Optional lead under the heading */
	lead?: string;
	class?: string;
}

const {
	kind = 'all',
	size = 'default',
	heading = 'Bookshelf',
	lead,
	class: className,
} = Astro.props;

const visible = kind === 'all' ? bookshelf : getBookshelfByKind(kind);
const books = visible.filter((item) => item.kind === 'book');
const articles = visible.filter((item) => item.kind === 'article');
---

{
	visible.length > 0 && (
		<section class:list={['bookshelf', className]}>
			<header class="bookshelf__header">
				<h2 class="bookshelf__heading">{heading}</h2>
				{lead && <p class="bookshelf__lead">{lead}</p>}
			</header>

			{kind === 'all' ? (
				<>
					{books.length > 0 && (
						<div class="bookshelf__section">
							<h3 class="bookshelf__subheading">Books</h3>
							<div class="bookshelf__grid">
								{books.map((item) => (
									<BookshelfPoster item={item} size={size} />
								))}
							</div>
						</div>
					)}
					{articles.length > 0 && (
						<div class="bookshelf__section">
							<h3 class="bookshelf__subheading">Articles</h3>
							<div class="bookshelf__grid">
								{articles.map((item) => (
									<BookshelfPoster item={item} size={size} />
								))}
							</div>
						</div>
					)}
				</>
			) : (
				<div class="bookshelf__grid">
					{visible.map((item) => (
						<BookshelfPoster item={item} size={size} />
					))}
				</div>
			)}
		</section>
	)
}

<style>
	.bookshelf {
		display: flex;
		flex-direction: column;
		gap: 1.25rem;
		width: 100%;
	}

	.bookshelf__header {
		display: flex;
		flex-direction: column;
		gap: 0.35rem;
		max-width: 40rem;
	}

	.bookshelf__heading {
		font-size: 1.25rem;
		font-weight: 500;
		margin: 0;
		color: var(--color-text-primary);
		text-transform: capitalize;
	}

	.bookshelf__lead {
		margin: 0;
		color: var(--color-text-secondary);
		line-height: var(--leading-normal);
		font-size: var(--text-base);
	}

	.bookshelf__section {
		display: flex;
		flex-direction: column;
		gap: 0.85rem;
	}

	.bookshelf__section + .bookshelf__section {
		margin-top: 0.75rem;
	}

	.bookshelf__subheading {
		font-size: 1rem;
		font-weight: 500;
		margin: 0;
		color: var(--color-text-primary);
	}

	.bookshelf__grid {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: 1.25rem 0.85rem;
	}

	@media (min-width: 640px) {
		.bookshelf__grid {
			grid-template-columns: repeat(3, minmax(0, 1fr));
			gap: 1.5rem 1rem;
		}
	}

	@media (min-width: 1024px) {
		.bookshelf__grid {
			grid-template-columns: repeat(4, minmax(0, 1fr));
		}
	}
</style>
