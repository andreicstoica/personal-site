---
import { bookshelf } from '../../lib/bookshelf';
import BookshelfPoster from './BookshelfPoster.astro';

interface Props {
	heading?: string;
	lead?: string;
	class?: string;
}

const {
	heading = 'Bookshelf',
	lead,
	class: className,
} = Astro.props;
---

{
	bookshelf.length > 0 && (
		<section class:list={['bookshelf', className]}>
			<header class="bookshelf__header">
				<h2 class="bookshelf__heading">{heading}</h2>
				{lead && <p class="bookshelf__lead">{lead}</p>}
			</header>

			<div class="bookshelf__stage">
				<ul class="bookshelf__row">
					{bookshelf.map((item) => (
						<li class="bookshelf__slot">
							<BookshelfPoster item={item} />
						</li>
					))}
				</ul>
				<div class="bookshelf__plank" aria-hidden="true" />
			</div>
		</section>
	)
}

<style>
	.bookshelf {
		display: flex;
		flex-direction: column;
		gap: 0.85rem;
		width: 100%;
	}

	.bookshelf__header {
		display: flex;
		flex-direction: column;
		gap: 0.3rem;
	}

	.bookshelf__heading {
		font-size: 1.25rem;
		font-weight: 500;
		margin: 0;
		color: var(--color-text-primary);
		text-transform: capitalize;
	}

	.bookshelf__lead {
		margin: 0;
		color: var(--color-text-secondary);
		line-height: var(--leading-normal);
		font-size: var(--text-sm);
		max-width: 36rem;
	}

	.bookshelf__stage {
		position: relative;
		padding: 0.35rem 0 0;
	}

	.bookshelf__row {
		list-style: none;
		margin: 0;
		padding: 0.5rem 0.15rem 0;
		display: flex;
		align-items: flex-end;
		gap: 0.65rem;
		overflow-x: auto;
		overscroll-behavior-x: contain;
		scrollbar-width: thin;
		-webkit-overflow-scrolling: touch;
	}

	.bookshelf__slot {
		margin: 0;
		padding: 0;
		flex: 0 0 auto;
	}

	.bookshelf__plank {
		height: 0.65rem;
		margin-top: -1px;
		border-radius: 2px;
		background: linear-gradient(
			to bottom,
			color-mix(in srgb, var(--color-text-primary) 12%, var(--color-bg-primary)),
			color-mix(in srgb, var(--color-text-primary) 22%, var(--color-bg-primary))
		);
		box-shadow:
			0 8px 16px -10px rgb(0 0 0 / 0.35),
			0 2px 0 color-mix(in srgb, var(--color-text-primary) 18%, transparent);
	}

	@media (prefers-color-scheme: dark) {
		.bookshelf__plank {
			background: linear-gradient(
				to bottom,
				color-mix(in srgb, #fff 10%, var(--color-bg-primary)),
				color-mix(in srgb, #fff 18%, var(--color-bg-primary))
			);
			box-shadow:
				0 8px 16px -10px rgb(0 0 0 / 0.65),
				0 2px 0 color-mix(in srgb, #fff 12%, transparent);
		}
	}
</style>
