---
import { bookshelf } from '../../lib/bookshelf';
import BookshelfPoster from './BookshelfPoster.astro';

interface Props {
	heading?: string;
	lead?: string;
	class?: string;
}

const {
	heading = 'Bookshelf',
	lead,
	class: className,
} = Astro.props;

// Long enough ASCII board; clipped to the book row width via overflow:hidden
const shelfTop = `+${'-'.repeat(120)}+`;
const shelfMid = `|${'='.repeat(120)}|`;
const shelfBot = `+${'-'.repeat(120)}+`;
---

{
	bookshelf.length > 0 && (
		<section class:list={['bookshelf', className]}>
			<header class="bookshelf__header">
				<h2 class="bookshelf__heading">{heading}</h2>
				{lead && <p class="bookshelf__lead">{lead}</p>}
			</header>

			<div class="bookshelf__stage">
				<div class="bookshelf__inner">
					<ul class="bookshelf__row">
						{bookshelf.map((item) => (
							<li class="bookshelf__slot">
								<BookshelfPoster item={item} />
							</li>
						))}
					</ul>
					<pre class="bookshelf__plank" aria-hidden="true">{shelfTop}
{shelfMid}
{shelfBot}</pre>
				</div>
			</div>
		</section>
	)
}

<style>
	.bookshelf {
		display: flex;
		flex-direction: column;
		gap: 1rem;
		width: 100%;
		padding-block: 0.25rem 0.75rem;
	}

	.bookshelf__header {
		display: flex;
		flex-direction: column;
		gap: 0.35rem;
		padding-inline: 0.15rem;
	}

	.bookshelf__heading {
		font-size: 1.25rem;
		font-weight: 500;
		margin: 0;
		color: var(--color-text-primary);
		text-transform: capitalize;
	}

	.bookshelf__lead {
		margin: 0;
		color: var(--color-text-secondary);
		line-height: var(--leading-normal);
		font-size: var(--text-sm);
		max-width: 36rem;
	}

	.bookshelf__stage {
		overflow-x: auto;
		overscroll-behavior-x: contain;
		scrollbar-width: thin;
		-webkit-overflow-scrolling: touch;
		padding-block: 0.35rem 0.5rem;
	}

	.bookshelf__inner {
		display: inline-flex;
		flex-direction: column;
		width: max-content;
		max-width: none;
		gap: 0.85rem;
		padding-inline: 0.75rem;
		padding-top: 0.35rem;
	}

	.bookshelf__row {
		list-style: none;
		margin: 0;
		padding: 0;
		display: flex;
		align-items: flex-end;
		gap: 0.85rem;
	}

	.bookshelf__slot {
		margin: 0;
		padding: 0;
		flex: 0 0 auto;
	}

	.bookshelf__plank {
		margin: 0;
		padding: 0;
		width: 100%;
		overflow: hidden;
		font-family: var(--font-mono);
		font-size: 0.7rem;
		line-height: 1;
		letter-spacing: 0.02em;
		color: var(--color-text-secondary);
		user-select: none;
		white-space: pre;
	}
</style>
