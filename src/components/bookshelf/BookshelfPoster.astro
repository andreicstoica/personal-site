---
import type { BookshelfItem } from '../../lib/bookshelf';

interface Props {
	item: BookshelfItem;
	/** Slightly smaller poster for teaser rows */
	size?: 'default' | 'compact';
}

const { item, size = 'default' } = Astro.props;
const { poster, kind, title, author, year, url, cover, note } = item;
const href = url ?? undefined;
const Tag = href ? 'a' : 'div';
const kindLabel = kind === 'book' ? 'Book' : 'Article';
const sizeClass = size === 'compact' ? 'bookshelf-poster--compact' : '';
---

<Tag
	class:list={[
		'bookshelf-poster',
		`bookshelf-poster--${poster.theme}`,
		`bookshelf-poster--${poster.layout}`,
		sizeClass,
	]}
	href={href}
	target={href ? '_blank' : undefined}
	rel={href ? 'noopener noreferrer' : undefined}
	aria-label={`${kindLabel}: ${title} by ${author}${href ? ' (opens in new tab)' : ''}`}
>
	{
		cover ? (
			<img
				class="bookshelf-poster__cover"
				src={`/images/bookshelf/${cover}`}
				alt=""
				loading="lazy"
				decoding="async"
			/>
		) : (
			<div class="bookshelf-poster__art" aria-hidden="true">
				<span class="bookshelf-poster__kind">{kindLabel}</span>
				<div class="bookshelf-poster__mark" />
				<div class="bookshelf-poster__rule" />
				<h3 class="bookshelf-poster__title">{title}</h3>
				<p class="bookshelf-poster__author">{author}</p>
				{year && <p class="bookshelf-poster__year">{year}</p>}
			</div>
		)
	}
	<div class="bookshelf-poster__caption">
		<p class="bookshelf-poster__caption-title">{title}</p>
		<p class="bookshelf-poster__caption-meta">
			{author}{year ? ` · ${year}` : ''} · {kindLabel}
		</p>
		{note && <p class="bookshelf-poster__caption-note">{note}</p>}
	</div>
</Tag>

<style>
	.bookshelf-poster {
		display: flex;
		flex-direction: column;
		gap: 0.75rem;
		text-decoration: none;
		color: inherit;
		min-width: 0;
	}

	.bookshelf-poster__art,
	.bookshelf-poster__cover {
		aspect-ratio: 2 / 3;
		width: 100%;
		border: 1px solid var(--color-text-primary);
		position: relative;
		overflow: hidden;
		isolation: isolate;
		transition:
			transform var(--duration-ui) var(--ease-out),
			box-shadow var(--duration-ui) var(--ease-out);
	}

	.bookshelf-poster__cover {
		object-fit: cover;
		display: block;
		background: var(--color-bg-secondary);
	}

	@media (hover: hover) and (pointer: fine) {
		a.bookshelf-poster:hover .bookshelf-poster__art,
		a.bookshelf-poster:hover .bookshelf-poster__cover {
			transform: translateY(-3px);
			box-shadow: 4px 4px 0 var(--color-text-primary);
		}
	}

	.bookshelf-poster__art {
		display: flex;
		flex-direction: column;
		justify-content: flex-end;
		padding: 0.9rem;
		box-sizing: border-box;
	}

	.bookshelf-poster--compact .bookshelf-poster__art,
	.bookshelf-poster--compact .bookshelf-poster__cover {
		/* keep 2:3; width constrained by grid */
	}

	.bookshelf-poster__kind {
		position: absolute;
		top: 0.75rem;
		left: 0.75rem;
		font-family: var(--font-mono);
		font-size: 0.65rem;
		letter-spacing: 0.08em;
		text-transform: uppercase;
		z-index: 2;
	}

	.bookshelf-poster__title {
		font-family: 'LumberSans', var(--font-sans);
		font-size: clamp(1.05rem, 2.4vw, 1.45rem);
		line-height: 1.05;
		letter-spacing: -0.02em;
		text-wrap: balance;
		margin: 0;
		z-index: 2;
		position: relative;
	}

	.bookshelf-poster--compact .bookshelf-poster__title {
		font-size: clamp(0.95rem, 2vw, 1.15rem);
	}

	.bookshelf-poster__author,
	.bookshelf-poster__year {
		font-family: var(--font-mono);
		font-size: 0.7rem;
		margin: 0.35rem 0 0;
		z-index: 2;
		position: relative;
		opacity: 0.9;
	}

	.bookshelf-poster__year {
		margin-top: 0.15rem;
		opacity: 0.7;
	}

	.bookshelf-poster__mark,
	.bookshelf-poster__rule {
		position: absolute;
		pointer-events: none;
		z-index: 1;
	}

	/* themes */
	.bookshelf-poster--ink .bookshelf-poster__art {
		background: #1a1a1a;
		color: #fefefe;
		border-color: #1a1a1a;
	}

	.bookshelf-poster--primary .bookshelf-poster__art {
		background: var(--color-primary);
		color: #fefefe;
		border-color: var(--color-primary);
	}

	.bookshelf-poster--secondary .bookshelf-poster__art {
		background: var(--color-secondary);
		color: #fefefe;
		border-color: var(--color-secondary);
	}

	.bookshelf-poster--accent .bookshelf-poster__art {
		background: var(--color-accent);
		color: #fefefe;
		border-color: var(--color-accent);
	}

	.bookshelf-poster--warning .bookshelf-poster__art {
		background: var(--color-warning);
		color: #1a1a1a;
		border-color: #1a1a1a;
	}

	.bookshelf-poster--paper .bookshelf-poster__art {
		background: #f3efe6;
		color: #1a1a1a;
		border-color: #1a1a1a;
	}

	/* layouts — geometric poster language */
	.bookshelf-poster--stack .bookshelf-poster__mark {
		width: 42%;
		aspect-ratio: 1;
		border-radius: 999px;
		border: 2px solid currentColor;
		opacity: 0.35;
		top: 18%;
		right: -8%;
	}

	.bookshelf-poster--banner .bookshelf-poster__rule {
		inset: 28% 0 auto;
		height: 28%;
		background: color-mix(in srgb, currentColor 14%, transparent);
	}

	.bookshelf-poster--banner .bookshelf-poster__mark {
		width: 18%;
		aspect-ratio: 1;
		background: currentColor;
		opacity: 0.2;
		top: 12%;
		right: 10%;
	}

	.bookshelf-poster--diagonal .bookshelf-poster__rule {
		inset: -20% -30%;
		height: 40%;
		background: color-mix(in srgb, currentColor 16%, transparent);
		transform: rotate(-28deg);
		transform-origin: center;
	}

	.bookshelf-poster--diagonal .bookshelf-poster__mark {
		width: 55%;
		height: 2px;
		background: currentColor;
		opacity: 0.45;
		top: 22%;
		left: 12%;
		transform: rotate(-28deg);
	}

	.bookshelf-poster--corner .bookshelf-poster__mark {
		width: 55%;
		aspect-ratio: 1;
		border: 2px solid currentColor;
		opacity: 0.28;
		top: -12%;
		left: -18%;
	}

	.bookshelf-poster--corner .bookshelf-poster__rule {
		width: 2px;
		inset: 0 18% 0 auto;
		background: currentColor;
		opacity: 0.25;
	}

	.bookshelf-poster__caption-title {
		font-size: var(--text-sm);
		font-weight: 500;
		margin: 0;
		color: var(--color-text-primary);
		line-height: var(--leading-tight);
	}

	.bookshelf-poster__caption-meta {
		font-family: var(--font-mono);
		font-size: 0.7rem;
		color: var(--color-text-muted);
		margin: 0.2rem 0 0;
	}

	.bookshelf-poster__caption-note {
		font-size: var(--text-sm);
		color: var(--color-text-secondary);
		margin: 0.35rem 0 0;
		line-height: var(--leading-normal);
	}

	@media (prefers-reduced-motion: reduce) {
		.bookshelf-poster__art,
		.bookshelf-poster__cover {
			transition: none;
		}

		a.bookshelf-poster:hover .bookshelf-poster__art,
		a.bookshelf-poster:hover .bookshelf-poster__cover {
			transform: none;
			box-shadow: none;
		}
	}
</style>
