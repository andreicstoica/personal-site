---
import { socialNavItems } from "../../lib/navLinks";
import BeosIcon from "./BeosIcon.astro";

// Frozen at build time in astro.config.mjs — UTC keeps the rendered date
// identical no matter where the request is served from.
const updatedAt = new Date(__BUILD_DATE__).toLocaleDateString("en-US", {
	month: "short",
	day: "numeric",
	year: "numeric",
	timeZone: "UTC",
});
---

<footer class="site-footer" transition:persist="site-footer">
  <div class="site-footer-inner">
    <nav aria-label="Social links">
      <ul class="site-footer-list">
        {
          socialNavItems.map((item) => (
            <li>
              <a href={item.href} target="_blank" rel="noopener noreferrer">
                <BeosIcon kind={item.icon} />
                <span>{item.label}</span>
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
    <p class="site-footer-updated">
      Last updated <time datetime={__BUILD_DATE__.slice(0, 10)}>{updatedAt}</time>
    </p>
  </div>
</footer>

<style>
  .site-footer {
    margin-top: 2.5rem;
    padding-block: var(--spacing-lg);
    border-top: 1px solid var(--color-bg-secondary);
  }

  .site-footer-inner {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem 1.25rem;
  }

  .site-footer-updated {
    /* auto margin holds the right edge even after the row wraps */
    margin: 0 0 0 auto;
    color: var(--color-text-secondary);
    font-family: var(--font-mono);
    font-variation-settings: var(--font-mono-axes, normal);
    font-size: var(--text-xs);
    white-space: nowrap;
  }

  .site-footer-list {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.25rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  /* The ::before keeps a 44px-tall tap area while the layout box matches the
     visible text, so the footer spaces with plain tokens. */
  .site-footer-list a {
    position: relative;
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    color: var(--color-text-primary);
    font-size: var(--text-sm);
  }

  .site-footer-list a::before {
    content: "";
    position: absolute;
    inset: -0.75rem -0.375rem;
  }

  /* Below 768px the footer stacks and centers on the spacing scale.
     Centered, the date clears the corner chat button (FloatingChat.svelte). */
  @media (max-width: 767.98px) {
    .site-footer {
      margin-top: var(--spacing-lg);
      padding-block: var(--spacing-lg)
        calc(var(--spacing-lg) + env(safe-area-inset-bottom, 0px));
    }

    .site-footer-inner {
      flex-direction: column;
      gap: var(--spacing-sm);
    }

    .site-footer-list {
      justify-content: center;
    }

    .site-footer-updated {
      margin: 0;
    }
  }

  /* Phones: all four links fit one row. */
  @media (max-width: 40rem) {
    .site-footer-list {
      gap: 0.25rem 0.875rem;
    }

    .site-footer-list a {
      gap: 0.375rem;
      font-size: var(--text-xs);
    }

    .site-footer-list :global(.beos-icon) {
      width: 18px;
      height: 18px;
    }
  }
</style>
