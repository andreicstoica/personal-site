---
import type { NavItem } from "../../lib/navLinks";

interface Props {
	crumb?: string;
	parent?: NavItem;
}

const { crumb, parent } = Astro.props;
---

<header class:list={["site-nav", { "site-nav-home": !crumb }]}>
  {
    crumb ? (
      <nav aria-label="Breadcrumb">
        <ol class="trail">
          <li class="trail-home">
            <a href="/" class="nav-name" transition:name="site-name">
              Andrei Stoica
            </a>
          </li>
          {
            parent && (
              <li class="trail-parent">
                <span class="trail-sep" aria-hidden="true">
                  /
                </span>
                <a href={parent.href} class="trail-link">
                  {parent.label}
                </a>
              </li>
            )
          }
          <li class="trail-current" aria-current="page">
            <span class="trail-sep" aria-hidden="true">
              /
            </span>
            <span class="trail-page">{crumb}</span>
          </li>
        </ol>
      </nav>
    ) : (
      <h1 class="nav-heading">
        <span class="nav-name" transition:name="site-name">Andrei Stoica</span>
      </h1>
    )
  }
</header>

<style>
  /* The group moves the name from its old viewport box to the new one.
     prepareSiteNameTransition() drops the name when that box is not the
     header slot. `hold` also cancels the group animation, so a one-sided
     snapshot cannot slide in from the default top-left position. */
  :global(::view-transition-group(site-name)) {
    animation-duration: var(--duration-drawer);
    animation-timing-function: var(--ease-in-out);
  }

  :global(html[data-site-name-vt="hold"]::view-transition-group(site-name)) {
    animation: none;
  }

  :global(::view-transition-old(site-name)) {
    display: none;
  }

  :global(::view-transition-new(site-name)) {
    animation: none;
  }

  @media (prefers-reduced-motion: reduce) {
    :global(::view-transition-group(site-name)),
    :global(::view-transition-old(site-name)),
    :global(::view-transition-new(site-name)) {
      animation: none;
    }
  }

  .site-nav {
    padding-block: 0.75rem 0.25rem;
    text-align: center;
  }

  .nav-heading {
    line-height: inherit;
    letter-spacing: inherit;
  }

  .site-nav .nav-name {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    padding-block-end: 0;
    font-size: 1.875rem;
    font-weight: 700;
    line-height: var(--leading-tight);
    letter-spacing: -0.02em;
    text-decoration-line: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.2em;
    text-decoration-color: transparent;
    transition: text-decoration-color var(--duration-ui) var(--ease-out);
  }

  @media (hover: hover) and (pointer: fine) {
    .site-nav a.nav-name:hover {
      text-decoration-color: currentColor;
    }
  }

  .trail {
    display: flex;
    justify-content: center;
    align-items: baseline;
    min-width: 0;
    margin: 0;
    padding: 0;
    list-style: none;
    font-size: 1.875rem;
    letter-spacing: -0.02em;
    line-height: var(--leading-tight);
  }

  .trail-home,
  .trail-parent {
    flex-shrink: 0;
  }

  .trail-parent {
    display: flex;
    align-items: baseline;
  }

  /* A parent crumb is a way back, so it recedes to the secondary color and
     keeps the site's dotted link mark; the page the visitor is on reads
     strongest. A flex item is a block, so its line box already holds the
     underline. */
  .trail-link {
    padding-block-end: 0;
    color: var(--color-text-secondary);
    transition: color var(--duration-ui) var(--ease-out);
  }

  @media (hover: hover) and (pointer: fine) {
    .trail-link:hover {
      color: var(--color-text-primary);
    }
  }

  .trail-current {
    display: flex;
    align-items: baseline;
    min-width: 0;
    color: var(--color-text-primary);
  }

  .trail-sep {
    flex-shrink: 0;
    padding-inline: 0.4em;
    color: var(--color-text-muted);
    font-weight: 400;
  }

  /* The page title below shows the full name, so as a last resort the crumb
     truncates. */
  .trail-page {
    overflow: hidden;
    white-space: nowrap;
    text-overflow: ellipsis;
  }

  @media (width < 40rem) {
    .trail-parent {
      position: relative;
      top: -0.06em;
      font-size: 1.125rem;
    }
  }
</style>

<script>
  import { settledBannerHeight, siteNameShouldMorph } from "../../lib/siteNameTransition";

  const scope = window as Window & {
    __siteNameVt?: boolean;
    __weatherBannerSlid?: boolean;
    __weatherBannerOpened?: boolean;
  };

  // Once per document. ClientRouter re-runs this module on each swap; a second
  // listener would stamp the banner again after the snapshot.
  if (!scope.__siteNameVt) {
    scope.__siteNameVt = true;
    document.addEventListener("astro:after-preparation", prepareSiteNameTransition);
    // The swap replaces html attributes from the incoming document, which does
    // not know about this flag. Copy it or the hold rule never applies.
    document.addEventListener("astro:before-swap", (event) => {
      const next = event.newDocument.documentElement;
      if (document.documentElement.dataset.siteNameVt === "hold") {
        next.dataset.siteNameVt = "hold";
      } else {
        delete next.dataset.siteNameVt;
      }
    });
  }

  function prepareSiteNameTransition(): void {
    const frame = document.querySelector("[data-banner-frame]");
    if (frame instanceof HTMLElement) {
      const body = frame.querySelector("[data-banner-body]");
      const height = settledBannerHeight({
        slid: scope.__weatherBannerSlid === true,
        opened: scope.__weatherBannerOpened === true,
        bodyHeight: body instanceof HTMLElement ? body.offsetHeight : 0,
      });
      if (height !== null) {
        // The incoming frame opens to this height inside the swap, before its
        // snapshot. Commit it here, in the same turn as the old snapshot, and
        // mark the slide finished so the new frame does not animate shut-to-open.
        scope.__weatherBannerSlid = true;
        frame.classList.remove("is-opening");
        document.querySelector("[data-page-scroll]")?.classList.remove("is-banner-opening");
        frame.style.setProperty("--banner-height", `${height}px`);
        document.documentElement.dataset.weatherBanner = "open";
      }
    }

    const name = document.querySelector(".nav-name");
    if (!(name instanceof HTMLElement)) return;
    const scroller = name.closest("[data-page-scroll]");
    if (!(scroller instanceof HTMLElement)) {
      name.style.viewTransitionName = "none";
      return;
    }
    const rect = name.getBoundingClientRect();
    const bounds = scroller.getBoundingClientRect();
    const morph = siteNameShouldMorph({
      scrollTop: scroller.scrollTop,
      width: rect.width,
      height: rect.height,
      top: rect.top,
      bottom: rect.bottom,
      scrollerTop: bounds.top,
      scrollerBottom: bounds.bottom,
    });
    if (morph) delete document.documentElement.dataset.siteNameVt;
    else document.documentElement.dataset.siteNameVt = "hold";
    name.style.viewTransitionName = morph ? "site-name" : "none";
  }
</script>
