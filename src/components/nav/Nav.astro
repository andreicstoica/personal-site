---
import type { NavItem } from "../../lib/navLinks";

interface Props {
	crumb?: string;
	parent?: NavItem;
}

const { crumb, parent } = Astro.props;
---

<header class:list={["site-nav", { "site-nav-home": !crumb }]}>
  {
    crumb ? (
      <nav aria-label="Breadcrumb">
        <ol class="trail">
          <li class="trail-home">
            <a href="/" class="nav-name" transition:name="site-name">
              Andrei Stoica
            </a>
          </li>
          {
            parent && (
              <li class="trail-parent">
                <span class="trail-sep" aria-hidden="true">
                  /
                </span>
                <a href={parent.href} class="trail-link">
                  {parent.label}
                </a>
              </li>
            )
          }
          <li class="trail-current" aria-current="page">
            <span class="trail-sep" aria-hidden="true">
              /
            </span>
            <span class="trail-page">{crumb}</span>
          </li>
        </ol>
      </nav>
    ) : (
      <h1 class="nav-heading">
        <span class="nav-name" transition:name="site-name">Andrei Stoica</span>
      </h1>
    )
  }
</header>

<style>
  :global(::view-transition-group(site-name)) {
    animation-duration: var(--duration-drawer);
    animation-timing-function: var(--ease-in-out);
  }

  :global(::view-transition-old(site-name)) {
    display: none;
  }

  :global(::view-transition-new(site-name)) {
    animation: none;
  }

  @media (prefers-reduced-motion: reduce) {
    :global(::view-transition-group(site-name)),
    :global(::view-transition-old(site-name)),
    :global(::view-transition-new(site-name)) {
      animation: none;
    }
  }

  .site-nav {
    padding-block: 0.75rem 0.25rem;
    text-align: center;
  }

  .nav-heading {
    line-height: inherit;
    letter-spacing: inherit;
  }

  .site-nav .nav-name {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    padding-block-end: 0;
    font-size: 1.875rem;
    font-weight: 700;
    line-height: var(--leading-tight);
    letter-spacing: -0.02em;
    text-decoration-line: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.2em;
    text-decoration-color: transparent;
    transition: text-decoration-color var(--duration-ui) var(--ease-out);
  }

  @media (hover: hover) and (pointer: fine) {
    .site-nav a.nav-name:hover {
      text-decoration-color: currentColor;
    }
  }

  .trail {
    display: flex;
    justify-content: center;
    align-items: baseline;
    min-width: 0;
    margin: 0;
    padding: 0;
    list-style: none;
    font-size: 1.875rem;
    letter-spacing: -0.02em;
    line-height: var(--leading-tight);
  }

  .trail-home,
  .trail-parent {
    flex-shrink: 0;
  }

  .trail-parent {
    display: flex;
    align-items: baseline;
  }

  /* A parent crumb is a way back, so it recedes to the secondary color and
     keeps the site's dotted link mark; the page the visitor is on reads
     strongest. A flex item is a block, so its line box already holds the
     underline. */
  .trail-link {
    padding-block-end: 0;
    color: var(--color-text-secondary);
    transition: color var(--duration-ui) var(--ease-out);
  }

  @media (hover: hover) and (pointer: fine) {
    .trail-link:hover {
      color: var(--color-text-primary);
    }
  }

  .trail-current {
    display: flex;
    align-items: baseline;
    min-width: 0;
    color: var(--color-text-primary);
  }

  .trail-sep {
    flex-shrink: 0;
    padding-inline: 0.4em;
    color: var(--color-text-muted);
    font-weight: 400;
  }

  /* The page title below shows the full name, so as a last resort the crumb
     truncates. */
  .trail-page {
    overflow: hidden;
    white-space: nowrap;
    text-overflow: ellipsis;
  }

  @media (width < 40rem) {
    .trail-parent {
      position: relative;
      top: -0.06em;
      font-size: 1.125rem;
    }
  }
</style>
