---
import type { ImageMetadata } from "astro";
import type { GalleryMedia, GalleryVariant } from "../../lib/types";
import ImageGallery from "./ImageGallery.svelte";

interface Props {
	images?: string[];
	experienceName: string;
	variant?: GalleryVariant;
}

const { images, experienceName, variant = "desktop" } = Astro.props;

if (!images || images.length === 0) {
	return null;
}

const allImages = import.meta.glob<{ default: ImageMetadata }>(
	"/src/assets/images/**/*.{jpeg,jpg,png,webp}",
);

const processedImages = await Promise.all(
	images.map(async (imageName): Promise<GalleryMedia | null> => {
		if (imageName.toLowerCase().endsWith(".webm")) {
			return {
				kind: "video",
				src: `/images/${imageName}`,
				alt: experienceName,
			};
		}

		const imagePath = `/src/assets/images/${imageName}`;
		if (imageName.toLowerCase().endsWith(".webp")) {
			return {
				kind: "image",
				src: `/images/${imageName}`,
				alt: experienceName,
				width: 1920,
				height: 1080,
			};
		}

		const imageModule = allImages[imagePath];
		if (!imageModule) return null;

		const image = await imageModule();

		return {
			kind: "image",
			src: image.default.src,
			alt: experienceName,
			width: image.default.width,
			height: image.default.height,
		};
	}),
);

const validImages = processedImages.filter(
	(img): img is GalleryMedia => img !== null,
);
---

<ImageGallery
  client:visible
  images={validImages}
  experienceName={experienceName}
  variant={variant}
/>
