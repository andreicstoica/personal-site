---
import path from "node:path";
import type { ImageMetadata } from "astro";
import sharp from "sharp";
import type { StitchCorner } from "../../lib/crossStitch";
import type { GalleryMedia, GalleryVariant } from "../../lib/types";
import ImageGallery from "./ImageGallery.svelte";

interface Props {
	images?: string[];
	experienceName: string;
	variant?: GalleryVariant;
	/** Image file name to the corner that gets a cross-stitched colțar. */
	stitches?: Partial<Record<string, StitchCorner>>;
}

const {
	images,
	experienceName,
	variant = "desktop",
	stitches = {},
} = Astro.props;

if (!images || images.length === 0) {
	return null;
}

// Public images are not processed by Astro, so read their real size. A wrong
// width/height attribute gives the strip thumbnail the wrong box until it loads.
const publicSizes = new Map<string, { width: number; height: number }>();

async function publicImageSize(imageName: string) {
	const cached = publicSizes.get(imageName);
	if (cached) return cached;
	try {
		const { width, height } = await sharp(
			path.join(process.cwd(), "public", "images", imageName),
		).metadata();
		if (!width || !height) return null;
		const size = { width, height };
		publicSizes.set(imageName, size);
		return size;
	} catch {
		return null;
	}
}

const allImages = import.meta.glob<{ default: ImageMetadata }>(
	"/src/assets/images/**/*.{jpeg,jpg,png,webp}",
);

const processedImages = await Promise.all(
	images.map(async (imageName): Promise<GalleryMedia | null> => {
		if (imageName.toLowerCase().endsWith(".webm")) {
			return {
				kind: "video",
				src: `/images/${imageName}`,
				alt: experienceName,
			};
		}

		const imagePath = `/src/assets/images/${imageName}`;
		if (imageName.toLowerCase().endsWith(".webp")) {
			const size = await publicImageSize(imageName);
			return {
				kind: "image",
				src: `/images/${imageName}`,
				alt: experienceName,
				width: size?.width ?? 1920,
				height: size?.height ?? 1080,
				stitch: stitches[imageName],
			};
		}

		const imageModule = allImages[imagePath];
		if (!imageModule) return null;

		const image = await imageModule();

		return {
			kind: "image",
			src: image.default.src,
			alt: experienceName,
			width: image.default.width,
			height: image.default.height,
			stitch: stitches[imageName],
		};
	}),
);

const validImages = processedImages.filter(
	(img): img is GalleryMedia => img !== null,
);
---

<ImageGallery
  client:visible
  images={validImages}
  experienceName={experienceName}
  variant={variant}
/>
