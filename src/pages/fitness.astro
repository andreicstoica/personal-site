---
import { getEntry, render } from "astro:content";
import MarkdownBody from "../components/content/MarkdownBody.astro";
import MediaGallery from "../components/gallery/MediaGallery.astro";
import ContentDocument from "../layouts/ContentDocument.astro";
import SiteLayout from "../layouts/SiteLayout.astro";

const raceEntry = await getEntry("pages", "race");
const outdoorsEntry = await getEntry("pages", "outdoors");
const race = raceEntry ? await render(raceEntry) : null;
const outdoors = outdoorsEntry ? await render(outdoorsEntry) : null;
const RaceContent = race?.Content;
const OutdoorsContent = outdoors?.Content;
---

<SiteLayout title="Fitness" description="Running and outdoor activities">
  <ContentDocument title="Fitness">
    <div class="flex flex-col gap-8">
      <section>
        <p class="text-lead max-w-2xl mb-3">
          Running and outdoor activities
        </p>
      </section>

      <MarkdownBody>
        {RaceContent && <RaceContent />}
        {OutdoorsContent && <OutdoorsContent />}
      </MarkdownBody>

      <section>
        <h2 class="text-xl font-medium mb-4 text-[--color-text-primary]">
          Races
        </h2>
        <MediaGallery
          images={[
            "queens.webp",
            "bronx-1.webp",
            "bronx-2.webp",
            "newport.webp",
            "staten-island.webp",
          ]}
          experienceName="Races"
          variant="desktop"
        />
        <h2 class="text-xl font-medium mt-2 mb-4 text-[--color-text-primary]">
          Outdoors
        </h2>
        <MediaGallery
          images={[
            "beach.webp",
            "sister-1.webp",
            "sister-2.webp",
            "sister-3.webp",
            "sister-4.webp",
          ]}
          experienceName="Outdoors"
          variant="desktop"
        />
      </section>
    </div>
  </ContentDocument>
</SiteLayout>
