---
import { getEntry } from "astro:content";
import Bookshelf from "../components/bookshelf/Bookshelf.astro";
import MarkdownSections from "../components/content/MarkdownSections.astro";
import MediaGallery from "../components/gallery/MediaGallery.astro";
import MarkdownLayout from "../layouts/MarkdownLayout.astro";
import PageLayout from "../layouts/PageLayout.astro";

const aboutEntry = await getEntry("pages", "about");
if (!aboutEntry) throw new Error("About entry not found");
---

<PageLayout
  title={aboutEntry.data.title}
  description={aboutEntry.data.description}
>
  <div class="about-layout w-full lg:mt-3.5 pb-8">
    <aside class="about-shelf">
      <Bookshelf
        heading="Bookshelf"
        lead="Books and articles that keep reshaping how I think."
        class="bookshelf--sidebar"
      />
    </aside>

    <div class="about-main">
      <MarkdownLayout title={aboutEntry.data.title}>
        <MarkdownSections
          body={aboutEntry.body}
          description={aboutEntry.data.description}
          lastUpdated="Last updated June 3, 2026"
          layout="stack"
        />
      </MarkdownLayout>

      <div class="mt-2">
        <MediaGallery
          images={["about.webp", "timbers.webp"]}
          experienceName="About"
          variant="desktop"
        />
      </div>
    </div>
  </div>
</PageLayout>

<style>
  .about-layout {
    display: flex;
    flex-direction: column;
    gap: 2rem;
  }

  .about-shelf {
    order: -1;
    width: 100%;
  }

  .about-main {
    max-width: 42rem;
    width: 100%;
  }

  @media (min-width: 1024px) {
    .about-layout {
      display: grid;
      grid-template-columns: minmax(0, 1fr) 9.5rem;
      gap: 2.75rem;
      align-items: start;
    }

    .about-shelf {
      order: 0;
      grid-column: 2;
      grid-row: 1;
      position: sticky;
      top: 5.5rem;
      width: auto;
    }

    .about-main {
      grid-column: 1;
      grid-row: 1;
    }
  }
</style>
