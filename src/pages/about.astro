---
import CollectionPage from "../components/content/CollectionPage.astro";
import MediaGallery from "../components/gallery/MediaGallery.astro";
---

<CollectionPage
  slug="about"
  layout="stack"
  lastUpdated="Last updated June 3, 2026"
  innerClass="w-full lg:mt-3.5 max-w-2xl"
>
  <div slot="after" class="mt-2 pb-8">
    <MediaGallery
      images={["about.webp", "timbers.webp"]}
      experienceName="About"
      variant="desktop"
    />
  </div>
</CollectionPage>
