---
import CollectionPage from "../components/content/CollectionPage.astro";
import MediaGallery from "../components/gallery/MediaGallery.astro";
---

<CollectionPage slug="colophon" layout="grid">
  <div class="mt-4 mb-4">
    <h2 class="text-xl font-medium mb-3 text-[--color-text-primary]">
      Memorial to my old sites (rip)
    </h2>
    <MediaGallery
      images={[
        "old-site-2021.webp",
        "old-site-2023.webp",
        "old-site-2025.webm",
      ]}
      experienceName="Previous site designs"
      variant="desktop"
    />
  </div>
</CollectionPage>
