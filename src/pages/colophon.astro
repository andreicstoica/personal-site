---
import CollectionPage from "../components/content/CollectionPage.astro";
import MediaGallery from "../components/gallery/MediaGallery.astro";
import { aboutCrumb } from "../lib/navLinks";
---

<CollectionPage slug="colophon" layout="grid" parent={aboutCrumb}>
  <div class="mt-4 mb-4">
    <h2 class="text-xl font-medium mb-3">
      Memorial to my old sites (rip)
    </h2>
    <MediaGallery
      images={[
        "old-site-2021.webp",
        "old-site-2023.webp",
        "old-site-2025.webm",
        "old-site-2025-2026.webp",
      ]}
      experienceName="Previous site designs"
      variant="desktop"
    />
  </div>
</CollectionPage>
