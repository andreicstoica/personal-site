---
import { getEntry } from "astro:content";
import MarkdownLayout from "../layouts/MarkdownLayout.astro";
import PageLayout from "../layouts/PageLayout.astro";
import {
	parseMarkdownContent,
	styleMarkdownContent,
} from "../lib/markdownUtils";

const nowEntry = await getEntry("pages", "now");
if (!nowEntry) throw new Error("Now entry not found");

const lastUpdated = "Last updated June 3, 2026";
const parsedContent = parseMarkdownContent(nowEntry.body);
---

<PageLayout title={nowEntry.data.title} description={nowEntry.data.description}>
  <MarkdownLayout title={nowEntry.data.title}>
    <div class="flex flex-col gap-2">
      <section>
        <p
          class="mb-4 font-mono text-xs uppercase tracking-[0.16em] text-[--color-text-secondary]"
        >
          {lastUpdated}
        </p>
        <p
          class="text-md max-w-2xl text-pretty text-[--color-text-primary] mb-3"
        >
          {nowEntry.data.description}
        </p>
      </section>

      <div class="space-y-6 max-w-3xl">
        {
          parsedContent.map((section) => (
            <section>
              <h2 class="text-xl font-medium mb-3 text-[--color-text-primary] capitalize">
                {section.title}
              </h2>
              <div class="space-y-2">
                <div set:html={styleMarkdownContent(section.content)} />
              </div>
            </section>
          ))
        }
      </div>
    </div>
  </MarkdownLayout>
</PageLayout>
