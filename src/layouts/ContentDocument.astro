---
import { lastUpdatedLabel } from "../lib/lastUpdated";

interface Props {
	title: string;
}

const { title } = Astro.props;
const updated = lastUpdatedLabel();
---

<main class="py-4 gap-6 flex flex-col pb-8">
  <div class="page-title">
    {title}
  </div>
  <div class="w-full text-pretty">
    <slot />
  </div>
  {updated && (
    <p class="mt-auto pt-6 text-end font-mono text-xs text-muted">{updated}</p>
  )}
</main>
