---
import { ClientRouter } from "astro:transitions";
import Analytics from "@vercel/analytics/astro";
import CursorTrail from "../components/chrome/CursorTrail.svelte";
import "../styles/global.css";

interface Props {
	title: string;
	description?: string;
}

const {
	title,
	description = "Product minded software engineer based in New York City.",
} = Astro.props;

// Unfurlers need absolute URLs. `site` is set in astro.config.
const pageUrl = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL("/og.png", Astro.site);
---

<!doctype html>
<html lang="en" transition:animate="none">
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content={description} />
    <meta name="author" content="Andrei Stoica" />
    <link rel="canonical" href={pageUrl} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Andrei Stoica" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={pageUrl} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta
      property="og:image:alt"
      content="Andrei on a couch with a laptop and plush animals, dithered in blue"
    />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta
      name="viewport"
      content="width=device-width, initial-scale=1.0, interactive-widget=resizes-content"
    />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
    <ClientRouter />
  </head>
  <body class="m-0 p-0 layout-body">
    <!-- Not in <head>: it renders a custom element, which ends the head when
         parsed, so Astro's stylesheets land in the body and the ClientRouter
         drops and reloads them on every navigation. -->
    <Analytics />
    <div class="layout-grid">
      <slot />
    </div>
    <!-- Body level, beside the page grid and not inside its scroll region, so
         the persisted drawer is never a grid item or a scroll container child.
         The chat fills this slot (SiteLayout.astro). -->
    <slot name="guide" />
    <CursorTrail client:idle transition:persist="cursor-trail" />
  </body>
</html>

<script>
  import { installMediaReveal } from "../lib/mediaReveal";

  installMediaReveal();
</script>
