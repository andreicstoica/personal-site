---
import { ClientRouter } from "astro:transitions";
import CursorTrail from "../components/chrome/CursorTrail.svelte";
import "../styles/global.css";

interface Props {
	title: string;
	description?: string;
}

const { title, description = "Andrei's Portfolio" } = Astro.props;
---

<!doctype html>
<html lang="en" transition:animate="none">
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content={description} />
    <meta name="author" content="Andrei Stoica" />
    <meta name="image" content="/cover.jpeg" />
    <meta
      name="viewport"
      content="width=device-width, initial-scale=1.0, interactive-widget=resizes-content"
    />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
    <ClientRouter />
  </head>
  <body class="m-0 p-0 layout-body">
    <div class="layout-grid">
      <slot />
    </div>
    <!-- Body level, beside the page grid and not inside its scroll region, so
         the persisted drawer is never a grid item or a scroll container child.
         The chat fills this slot (SiteLayout.astro). -->
    <slot name="guide" />
    <CursorTrail client:idle transition:persist="cursor-trail" />
  </body>
</html>

<script>
  import { installMediaReveal } from "../lib/mediaReveal";

  installMediaReveal();
</script>

<script
  is:inline
  data-goatcounter="https://andreistoica.goatcounter.com/count"
  async
  src="//gc.zgo.at/count.js"></script>
