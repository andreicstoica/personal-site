---
import FloatingChat from "../components/chat/FloatingChat.svelte";
import SiteFooter from "../components/footer/SiteFooter.astro";
import Nav from "../components/nav/Nav.astro";
import WeatherBanner from "../components/weather/WeatherBanner.svelte";
import { GUIDE_STORAGE_KEY } from "../lib/guideState";
import type { NavItem } from "../lib/navLinks";
import RootLayout from "./RootLayout.astro";

interface Props {
	title: string;
	description?: string;
	parent?: NavItem;
}

const { title, description, parent } = Astro.props;
const showLab = import.meta.env.DEV;
const isHome = Astro.url.pathname === "/";
---

<RootLayout title={title} description={description}>
  <script is:inline define:vars={{ guideKey: GUIDE_STORAGE_KEY }}>
    // Reserve room for an open chat drawer before paint, so the page does not
    // flash full width on load or on a ClientRouter swap (FloatingChat.svelte).
    (() => {
      const apply = () => {
        let open = false;
        try {
          open = JSON.parse(sessionStorage.getItem(guideKey) || "{}").open === true;
        } catch {}
        document.documentElement.dataset.guide = open ? "open" : "closed";
        document.documentElement.dataset.guideInstant = "";
      };
      apply();
      // ClientRouter re-runs inline scripts on each page; listen once.
      if (!window.__guideReserve) {
        window.__guideReserve = true;
        document.addEventListener("astro:after-swap", apply);
      }
    })();
  </script>
  <div class="col-span-12 h-full min-h-0 overflow-y-auto" data-page-scroll>
    <div class="flex min-h-full flex-col">
      <div class="site-column">
        <div class="banner-frame" data-banner-frame>
          <WeatherBanner
            client:only="svelte"
            showLab={showLab}
            transition:persist="weather-banner"
          />
        </div>
        <Nav crumb={isHome ? undefined : title} parent={parent} />
      </div>
      <div class="site-column flex flex-1 flex-col">
        <div
          class:list={["page-island flex w-full flex-1 flex-col", { "page-island-sub": !isHome }]}
          data-page-island
        >
          <slot />
        </div>
        <SiteFooter />
      </div>
    </div>
    <FloatingChat client:load />
  </div>
</RootLayout>

<style>
  /* Collapsed until the client-only banner is ready, so the server page has no
     empty hole above the fold. */
  .banner-frame {
    height: 0;
    margin-top: 0;
    overflow: hidden;
    background: var(--color-bg-sunken);
  }

  :global(html[data-weather-banner="open"]) .banner-frame {
    height: var(--banner-height);
    margin-top: 0.5rem;
  }

  /* Added only for the first reveal, then removed, so a viewport resize settles
     the banner instead of animating it again. In-out because the page content
     is already on screen and moves with it. */
  .banner-frame.is-opening {
    transition:
      height var(--duration-media) var(--ease-in-out),
      margin-top var(--duration-media) var(--ease-in-out);
  }

  /* Scroll anchoring would otherwise pull content back to cancel the slide. */
  :global([data-page-scroll].is-banner-opening) {
    overflow-anchor: none;
  }

  @media (prefers-reduced-motion: reduce) {
    .banner-frame.is-opening {
      transition: none;
    }
  }

  /* Subpages have no eyebrow above the title, so the header's breadcrumb needs
     the room the eyebrow used to take. */
  @media (min-width: 768px) {
    .page-island-sub {
      padding-top: var(--spacing-sm);
    }
  }
</style>

<script>
  function resetPageScroll(): void {
    const scroller = document.querySelector("[data-page-scroll]");
    if (scroller instanceof HTMLElement) {
      scroller.scrollTop = 0;
    }
  }

  resetPageScroll();
  document.addEventListener("astro:page-load", resetPageScroll);

  let bannerFrameBound: HTMLElement | null = null;

  function installBannerSlide(): void {
    const frame = document.querySelector<HTMLElement>("[data-banner-frame]");
    if (!frame) return;
    // Called on the first load and again on every swap; a frame is re-rendered
    // each time, so identity is what tells a fresh bind from a repeat one.
    if (bannerFrameBound === frame) return;
    bannerFrameBound = frame;

    const scroller = document.querySelector<HTMLElement>("[data-page-scroll]");
    const observer = new ResizeObserver((entries) => {
      const size = entries[0]?.borderBoxSize[0];
      if (size) frame.style.setProperty("--banner-height", `${size.blockSize}px`);
    });
    document.addEventListener("astro:before-swap", () => observer.disconnect(), {
      once: true,
    });

    const open = (slide: boolean): void => {
      // The client-only island may not have rendered its slot when this script
      // binds, so measure at open time. Without a length here the open height
      // is `auto`, which cannot transition, and the banner snaps in.
      const slot = frame.querySelector<HTMLElement>("[data-banner-slot]");
      if (!slot) return;
      frame.style.setProperty("--banner-height", `${slot.offsetHeight}px`);
      observer.observe(slot);
      if (!slide) {
        document.documentElement.dataset.weatherBanner = "open";
        return;
      }
      frame.classList.add("is-opening");
      scroller?.classList.add("is-banner-opening");
      document.documentElement.dataset.weatherBanner = "open";

      const settle = (): void => {
        frame.classList.remove("is-opening");
        scroller?.classList.remove("is-banner-opening");
      };
      // Reduced motion means no transition ever runs, so waiting on one alone
      // would strand the class and let a later resize animate the banner.
      const backstop = window.setTimeout(settle, 600);
      void Promise.all(frame.getAnimations().map((a) => a.finished))
        .then(settle)
        .catch(settle)
        .finally(() => window.clearTimeout(backstop));
    };

    // Ready is the island's signal; slid survives ClientRouter swaps so later
    // pages open at once instead of replaying the slide.
    const scope = window as Window & {
      __weatherBannerOpened?: boolean;
      __weatherBannerSlid?: boolean;
    };
    const slideOnce = (): void => {
      if (scope.__weatherBannerSlid) return;
      scope.__weatherBannerSlid = true;
      open(true);
    };
    if (scope.__weatherBannerSlid) {
      open(false);
      return;
    }
    // The island can finish before this script runs on a warm cache.
    if (scope.__weatherBannerOpened) slideOnce();
    else window.addEventListener("weather-banner:ready", slideOnce, { once: true });
  }

  installBannerSlide();
  document.addEventListener("astro:page-load", installBannerSlide);
</script>
