{
	"name": "personal-site",
	"type": "module",
	"version": "0.0.1",
	"scripts": {
		"dev": "astro dev",
		"build": "astro build",
		"preview": "astro build && bun scripts/serve-build.ts",
		"astro": "astro",
		"lint": "biome check --error-on-warnings src/",
		"lint:fix": "biome check --write src/",
		"lint:ui": "eslint .",
		"check": "astro check && svelte-check --tsconfig ./tsconfig.json",
		"test": "bun test",
		"verify": "biome check --error-on-warnings src/ && astro check && svelte-check --tsconfig ./tsconfig.json && bun test && astro build && bun scripts/check-build.ts"
	},
	"dependencies": {
		"@ai-sdk/openai-compatible": "^3.0.63",
		"@ai-sdk/svelte": "^5.0.128",
		"@astrojs/svelte": "9.0.1",
		"@astrojs/vercel": "11.0.3",
		"@tailwindcss/vite": "4.3.2",
		"@vercel/analytics": "^2.0.1",
		"ai": "^7.0.128",
		"astro": "7.0.9",
		"marked": "^16.1.1",
		"minisearch": "^7.2.0",
		"pixelarticons": "^2.4.2",
		"sharp": "^0.34.3",
		"svelte": "5.56.5",
		"tailwindcss": "4.3.2",
		"zod": "3.25.76"
	},
	"devDependencies": {
		"@astrojs/check": "^0.9.10",
		"@biomejs/biome": "^2.2.6",
		"@shadcn/lint": "^0.2.0",
		"@types/bun": "^1.4.2",
		"@typescript-eslint/parser": "^8.70.1",
		"eslint": "^10.11.0",
		"parse5": "7.3.0",
		"svelte-check": "^4.7.6",
		"svelte-eslint-parser": "^1.8.1",
		"typescript": "5.9.2"
	},
	"optionalDependencies": {
		"@aiforui/lapse": "^0.19.0"
	}
}
