{
	"name": "personal-site",
	"type": "module",
	"version": "0.0.1",
	"scripts": {
		"dev": "astro dev",
		"build": "astro build",
		"preview": "astro preview",
		"astro": "astro",
		"lint": "biome check --error-on-warnings src/",
		"lint:fix": "biome check --write src/",
		"lint:ui": "eslint .",
		"check": "astro check && svelte-check --tsconfig ./tsconfig.json",
		"test": "bun test",
		"verify": "biome check --error-on-warnings src/ && astro check && svelte-check --tsconfig ./tsconfig.json && bun test && astro build",
		"index": "tsx rag/build-index.ts",
		"rag:build": "tsx rag/build-index.ts",
		"rag:eval": "tsx rag/eval/run.ts",
		"rag:rebuild": "rm -rf rag/.cache rag/index.json rag/keyword-index.json && bun run rag:build"
	},
	"dependencies": {
		"@astrojs/svelte": "9.0.1",
		"@astrojs/vercel": "11.0.3",
		"@tailwindcss/vite": "4.3.2",
		"astro": "7.0.9",
		"marked": "^16.1.1",
		"minisearch": "^7.2.0",
		"sharp": "^0.34.3",
		"svelte": "5.56.5",
		"tailwindcss": "4.3.2",
		"zod": "3.25.76"
	},
	"devDependencies": {
		"@astrojs/check": "^0.9.10",
		"@biomejs/biome": "^2.2.6",
		"@shadcn/lint": "^0.2.0",
		"@types/bun": "^1.4.2",
		"@typescript-eslint/parser": "^8.70.1",
		"@xenova/transformers": "^2.17.2",
		"eslint": "^10.11.0",
		"p-limit": "^5.0.0",
		"svelte-check": "^4.7.6",
		"svelte-eslint-parser": "^1.8.1",
		"tsx": "^4.20.6",
		"typescript": "5.9.2"
	}
}
